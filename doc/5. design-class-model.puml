@startuml Design Class Model

    ' STATIC
    class AppController {
        io : IOController
        sc : SentenceController
        tc : TemplateController
        wp : WordPicker
        start() : void
        getValidSentence() : String
    }

    ' SINGLETON
    class IOController {
        instance : IOController
        scanner : Scanner
        getInstance() : IOController
        inputSentence() : String
        showInputError() : void
        displaySentence(sentenceDesc : String, flag : int) : void
        showValidationError() : void
        showSyntacticTree() : void
        showToxicityError() : void
        showToxicityResults(toxicityLabel : String, toxicityLevel : double) : void
    }

    ' SINGLETON
    class SentenceController {
        instance : SentenceController
        inputSentence : Sentence
        nonsenseSentence : Sentence
        currentSentence : Sentence
        state : boolean
        getInstance() : SentenceController
        createSentence(sentenceDesc : String) : void
        generateSentence() : void
        getSyntacticTree() : SyntacticNode
    }

    ' SINGLETON
    class SentenceGenerator {
        instance : SentenceGenerator
        sentenceDesc : String
        fillingWords : Map<String, List<String>>
        getInstance() : SentenceGenerator
        generateSentenceDesc() : void
    }
    
    class Sentence {
        sentenceDesc : String
        syntacticTree : SyntacticNode
        setSentenceTree(syntacticTree : SyntacticNode) : void
        getSentenceDesc() : String
        getSentenceTree() : SyntacticNode
    }

    class SyntacticNode {
        text : String
        lemma : String
        partOfSpeech : String
        dependency : String
        node : List<SyntacticNode>
        addChild(child : SyntacticNode, dependency : String) : void
        printTree(root : String) : String
    }

    ' SINGLETON
    class TemplateController {
        instance : TemplateController
        template : Template
        s : SentenceStructures
        getInstance() : TemplateController
        generateTemplate() : void
        getWordCount() : int[]
        getTemplateDesc() : String
    }

    ' SINGLETON
    class TemplateGenerator {
        instance : TemplateGenerator
        combinations : Map<Integer, List<int[]>>
        getInstance() : TemplateGenerator
        generateTemplate() : Template
    }

    class Template {
        templateDesc : String
        templateWords : int[]
    }
    
    ' STATIC
    class Analyzer {
        analyzeSentence(sentenceDesc : String) : void
        buildSyntacticTree(jsonInput : String) : SyntacticNode
    }

    ' STATIC
    class Validator {
        verifySentence(input : String) : boolean
        validateSentenceStructure(syntacticTree : SyntacticNode) : boolean
        verifyToxicity(sentenceDesc : String) : boolean
    }

    ' STATIC
    class ApiCaller {
        getSyntaxAnalysis(sentenceDesc : String) : String
        getToxicityAnalysis(sentenceDesc : String) : String
        getApiKey() : String
        makeCall(url : String, payload : String) : String
    }

    ' SINGLETON
    class WordPicker {
        instance : WordPicker
        generatedWords : Map<String, List<String>>
        numOfRetries : int
        getInstance() : WordPicker
        startWordsExtraction() : void
        pickSentenceWords() : void
        getWords() : Map<String, List<String>>
        analyzeSyntacticTree(syntactictree : SyntacticNode) : void
        loopOnNodes(node : SyntacticNode) : void
        resetNumOfRetries() : void
    }

    class SentenceStructures {
        structures : File
        dimension : int
        getRandomStructure() : String
    }

    ' SINGLETON
    class SystemDictionary {
        nouns : Nouns
        verbs : Verbs
        adjectives : Adjectives
        instance : SystemDictionary
        getInstance() : SystemDictionary
        createDictionary(nouns : List<String>, verbs : List<String>, adjectives : List<String>) : Map<String, List<String>>
        setupWordDic() : void
        initializeDic() : void
        pickDictionaryWords(words : int[]) : Map<String, List<String>>
    }

    class Nouns {
        nouns : List<String>
        getNouns(count : int) : List<String>
    }

    class Verbs {
        verbs : List<String>
        getVerbs(count : int) : List<String>
    }

    class Adjectives {
        adjectives : List<String>
        getAdjectives(count : int) : List<String>
    }

    '-----------------------------------------------------------------

    Nouns -o SystemDictionary
    Verbs -o SystemDictionary
    Adjectives -o SystemDictionary
    SyntacticNode -o Sentence
    SentenceStructures -o TemplateController

    ' IOController
    AppController "1" --> "1" IOController : gestione i/o 
    Validator "1" --> "1" IOController : gestione i/o 

    ' SentenceController
    AppController "1" --> "1" SentenceController : gestione sentence
    SentenceController "1" -- "*" Sentence : gestione istanze
    SentenceController "1" -- "1" SentenceGenerator
    SentenceController "1" --> "1" SentenceGenerator : createSentence
    SentenceController "1" --> "1" Analyzer : analyzeSentence
    Analyzer "1" --> "1" ApiCaller : getSyntaxAnalysis
    SentenceController "1" --> "1" IOController : displaySentence
    SentenceController "1" --> "1" Validator : verifyToxicity

    ' TemplateController
    AppController "1" --> "1" TemplateController : createTemplateController
    TemplateController "1" -- "1" TemplateGenerator
    TemplateController "1" --> "1" TemplateGenerator : new TemplateGenerator
    TemplateGenerator "1" --> "1" Template : create
    WordPicker "1" --> "1" TemplateController : getWordCount

    ' WordPicker
    AppController "1" --> "1" WordPicker : startWordsExtraction
    WordPicker "1" --> "1" SentenceController : getSyntacticTree
    WordPicker "1" --> "1" SystemDictionary : pickDictionaryWords

    ' Validator
    AppController "1" --> "1" Validator : verifySentence
    Validator "1" --> "1" ApiCaller : getToxicityAnalysis

@enduml